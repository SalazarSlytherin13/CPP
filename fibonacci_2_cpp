#include<iostream>
#include<vector>
using namespace std;

int fib(int n, vector<int> &dat ){
    if(n==1){
        return 0;
    }
    if(n==2){
        return 1;
    }
    if(dat[n]==0){
        dat[n]=fib(n-1,dat)+fib(n-2,dat);
    }
}

int main(){
    int n;
    cin>>n;
    vector<int> a(n);
    
    for(int i=0;i<n;i++){
        cin>>a[i];
    }
   
}

